# ============================================================
# KinoBot v4 — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Telegram Bot ---
BOT_TOKEN=your-telegram-bot-token-here

# Channels for mandatory subscription check (JSON array of [name, url, chat_id])
# Example: [["Main Channel", "https://t.me/mychannel", -1001234567890]]
CHANNELS=[]

# --- Web Admin Panel ---
# CHANGE THIS! Use: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-random-64-char-hex

# Admin credentials (CHANGE THESE!)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Server
HOST=0.0.0.0
PORT=5555
DEBUG=false

# --- TMDb Integration ---
TMDB_API_KEY=your-tmdb-api-key
TMDB_LANGUAGE=ru-RU

# --- Auto-Update ---
UPDATE_MANIFEST_URL=https://update.sgorel.ovh/versions/
AUTO_UPDATE=1

# --- Security ---
# Rate limiting (requests per minute for login)
LOGIN_RATE_LIMIT=5
# Session lifetime in hours
SESSION_LIFETIME_HOURS=24

# --- Database ---
# WAL mode for better concurrency (recommended: true)
DB_WAL_MODE=true
